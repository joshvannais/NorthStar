  "controlOperationOrder": [
    "pause_policy",
    "revoke_standing_authority",
    "engage_tenant_kill",
    "drain_policy",
    "cancel_action_unit",
    "resume_policy",
    "release_tenant_kill"
  ],
  "controlOperations": [
    {
      "id": "pause_policy",
      "authorityDirection": "reduce_only",
      "requiredCapabilityIds": ["automation_pause"],
      "eligibleMembershipRoleIds": ["owner", "admin"],
      "requiresRecentAuthentication": false,
      "targetKind": "policy_version",
      "allowedFromStates": ["active", "draining"],
      "resultingState": "paused",
      "dualControl": "not_required",
      "breakGlassAllowed": true,
      "boundary": "Blocks later new automation decisions for the exact policy. It does not prove queued, leased, in-flight, uncertain, provider-accepted or completed effects stopped."
    },
    {
      "id": "revoke_standing_authority",
      "authorityDirection": "terminal_reduce_only",
      "requiredCapabilityIds": ["automation_standing_authority_change"],
      "eligibleMembershipRoleIds": ["owner"],
      "requiresRecentAuthentication": true,
      "targetKind": "policy_version",
      "allowedFromStates": ["active", "paused", "draining"],
      "resultingState": "revoked_terminal",
      "dualControl": "not_required",
      "breakGlassAllowed": false,
      "boundary": "Permanently revokes the exact standing authorization and policy version. Resume of that version is denied; later authority requires a new policy version and new Part 3B standing authorization."
    },
    {
      "id": "engage_tenant_kill",
      "authorityDirection": "reduce_only",
      "requiredCapabilityIds": ["automation_tenant_stop_operate"],
      "eligibleMembershipRoleIds": ["owner", "admin"],
      "requiresRecentAuthentication": false,
      "targetKind": "tenant",
      "allowedFromStates": ["normal", "degraded", "draining"],
      "resultingState": "killed",
      "dualControl": "not_required",
      "breakGlassAllowed": true,
      "boundary": "Fail-safe tenant stop. It blocks later decisions, claims and provider attempts but never claims an already in-flight or externally observed effect was undone."
    },
    {
      "id": "drain_policy",
      "authorityDirection": "reduce_only",
      "requiredCapabilityIds": ["automation_pause"],
      "eligibleMembershipRoleIds": ["owner", "admin"],
      "requiresRecentAuthentication": false,
      "targetKind": "policy_version",
      "allowedFromStates": ["active", "paused"],
      "resultingState": "draining",
      "dualControl": "not_required",
      "breakGlassAllowed": true,
      "boundary": "Blocks new decisions and claims while preserving exact evidence for already leased, in-flight and uncertain work. It grants no resend, retry or effect authority."
    },
    {
      "id": "cancel_action_unit",
      "authorityDirection": "reduce_only",
      "requiredCapabilityIds": ["automation_pause"],
      "eligibleMembershipRoleIds": ["owner", "admin"],
      "requiresRecentAuthentication": false,
      "targetKind": "action_unit",
      "allowedFromStates": ["queued_not_claimed"],
      "resultingState": "cancelled_terminal",
      "dualControl": "not_required",
      "breakGlassAllowed": false,
      "boundary": "Cancels only one exact unclaimed Mission 28 action unit. It cannot cancel an upstream fact, leased or in-flight work, an uncertain provider outcome, or a completed effect."
    },
    {
      "id": "resume_policy",
      "authorityDirection": "increase_requires_current_authority",
      "requiredCapabilityIds": ["automation_standing_authority_change"],
      "eligibleMembershipRoleIds": ["owner"],
      "requiresRecentAuthentication": true,
      "targetKind": "policy_version",
      "allowedFromStates": ["paused", "drained"],
      "resultingState": "active",
      "dualControl": "conditional",
      "breakGlassAllowed": false,
      "boundary": "Requires exact current policy, sources, limits, preview, Part 3B standing authorization and trusted safe-state evidence. Terminal, killed, stale, degraded or uncertain authority never resumes."
    },
    {
      "id": "release_tenant_kill",
      "authorityDirection": "increase_requires_current_authority",
      "requiredCapabilityIds": ["automation_tenant_stop_operate"],
      "eligibleMembershipRoleIds": ["owner"],
      "requiresRecentAuthentication": true,
      "targetKind": "tenant",
      "allowedFromStates": ["killed"],
      "resultingState": "normal",
      "dualControl": "always_required",
      "breakGlassAllowed": false,
      "boundary": "Releasing a tenant-wide stop is distinct from engaging it and always requires two distinct currently eligible owner actors plus exact safe-state evidence. If distinct dual control is unavailable, release remains unavailable."
    }
  ],
