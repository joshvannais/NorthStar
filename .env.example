# Database
DATABASE_URL=postgresql://user:password@host:5432/northstar
DB_POOL_MAX=20

# Authentication
AUTH_ACCESS_SECRET=replace_with_at_least_32_random_bytes
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=30

# Retell AI API
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here

# Twilio (phone number)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=+1your_twilio_number_here

# Google Sheets (for lead storage)
GOOGLE_SHEETS_PRIVATE_KEY=your_google_private_key_here
GOOGLE_SHEETS_CLIENT_EMAIL=your_service_account_email_here
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Legacy operational email notifications (SMTP). These values do not construct
# the Account Lifecycle B1 transactional-email capability.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Account Lifecycle B1 transactional email (Resend Email API).
# Create and install a sending-only, domain-restricted key during a separately
# authorized release task. Never commit a real key.
RESEND_API_KEY=replace_with_resend_sending_only_domain_restricted_key
# Keep this a bare mailbox. The source-owned display name is "NorthStar Notifications".
TRANSACTIONAL_EMAIL_FROM=notifications@northstar-os.ai

# Canonical HTTPS origin used for server-derived verification/reset links.
# Transactional signup remains source-disabled unless this and every required
# Resend key and sender above are valid. There is intentionally no signup enable boolean.
PUBLIC_ORIGIN=https://www.northstar-os.ai

# Calendar integration
CALENDAR_TYPE=google
GOOGLE_CALENDAR_CREDENTIALS=path_to_credentials_json

# Server
PORT=3000
