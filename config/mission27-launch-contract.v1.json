{
  "contractVersion": "mission27.launch.v1",
  "policyState": "frozen_provider_disabled",
  "currency": {
    "code": "USD",
    "minorUnitExponent": 2,
    "rounding": "half_away_from_zero_at_owning_boundary",
    "foreignExchangeSupported": false
  },
  "sources": {
    "phone": {
      "class": "retell.inbound.completed.v1",
      "supported": true,
      "currentRuntimeAvailable": false,
      "requires": [
        "same_tenant_inbound_call",
        "authenticated_final_completed_lifecycle",
        "source_occurrence_time",
        "current_caller_consent",
        "current_retention_authority",
        "immutable_final_transcript_digest",
        "current_integration_identity",
        "human_review"
      ],
      "maximumDurationSeconds": 14400,
      "maximumTranscriptBytes": 524288,
      "excluded": [
        "outbound_call",
        "live_or_incomplete_call",
        "demo_or_sample_call",
        "provider_id_without_authenticated_lifecycle",
        "audio_or_transcript_without_current_consent",
        "caller_supplied_tenant_or_authority"
      ]
    },
    "photo": {
      "class": "northstar.quoted_job_photo.v1",
      "supported": true,
      "currentRuntimeAvailable": false,
      "contentTypes": ["image/jpeg", "image/png", "image/webp"],
      "maximumFiles": 10,
      "maximumBytesPerFile": 10485760,
      "maximumBytesPerIntake": 52428800,
      "maximumPixelsPerFile": 24000000,
      "maximumDimensionPixels": 8192,
      "rawRetentionDays": 30,
      "requires": [
        "same_tenant_intake",
        "exact_customer_or_prospect_and_location_context",
        "explicit_upload_consent",
        "server_verified_magic_and_digest",
        "malware_and_polyglot_scan",
        "metadata_stripped_before_extraction",
        "human_review"
      ],
      "excluded": [
        "heic",
        "pdf",
        "video",
        "audio",
        "animated_or_multiframe_image",
        "active_or_embedded_content",
        "signature_media",
        "field_execution_evidence_relabelled_as_quote_intake"
      ]
    }
  },
  "extraction": {
    "adapter": "openai.responses.structured.v1",
    "mode": "server_side_schema_constrained_store_false",
    "currentRuntimeAvailable": false,
    "maximumWallClockSeconds": 30,
    "maximumCandidatesPerIntake": 200,
    "providerToolsEnabled": false,
    "browserInferenceEnabled": false,
    "automaticFactAcceptance": false,
    "automaticCommercialAction": false,
    "requiresExactPins": ["provider", "model", "build", "config", "schema", "source_digest"],
    "blockedUntil": [
      "provider_and_privacy_review",
      "approved_server_credentials",
      "retention_and_consent_proof",
      "mounted_tenant_private_adapter",
      "independent_acceptance"
    ]
  },
  "estimatePolicy": {
    "maximumActiveOptions": 3,
    "maximumLinesPerOption": 100,
    "maximumLinesPerEstimate": 300,
    "maximumAssumptionsPerOption": 50,
    "maximumDescriptionCharacters": 2000,
    "maximumAssumptionCharacters": 500,
    "maximumProposalValidityDays": 30,
    "independentOptionTotals": true,
    "machineDraftCanApprovePrice": false
  },
  "signaturePolicy": {
    "method": "typed_name_explicit_consent_v1",
    "maximumRecipientsPerProposal": 1,
    "maximumPublicSessionHours": 168,
    "requires": [
      "exact_current_mission24_proposal_digest",
      "reviewed_recipient",
      "typed_signer_name",
      "versioned_consent_text",
      "affirmative_accept_and_sign_action",
      "server_acceptance_time",
      "current_scoped_session"
    ],
    "drawnOrBiometricSignatureSupported": false,
    "automaticDeliverySupported": false,
    "legalSufficiencyClaimed": false
  },
  "team": {
    "roleAloneAuthorizes": false,
    "ownerBootstrapTemplate": "m27.owner.v1",
    "adminBootstrapTemplate": "m27.admin.v1",
    "ownerDefaultCapabilities": [
      "customer_financial.source.review",
      "customer_financial.estimate.edit_draft",
      "customer_financial.estimate.edit_options",
      "customer_financial.estimate.request_signature",
      "customer_financial.estimate.review_signature",
      "customer_financial.estimate.request_work_handoff",
      "customer_financial.billing_identity.review",
      "customer_financial.document_numbering.review",
      "customer_financial.billable_work.review",
      "customer_financial.invoice.edit_draft",
      "customer_financial.invoice.approve",
      "customer_financial.invoice.issue",
      "customer_financial.invoice.send",
      "customer_financial.invoice.correct",
      "customer_financial.invoice.void",
      "customer_financial.provider.connect",
      "customer_financial.payment.initiate",
      "customer_financial.payment.record_offline",
      "customer_financial.payment.reconcile",
      "customer_financial.refund.issue",
      "customer_financial.write_off.record",
      "customer_financial.collection.action",
      "customer_financial.accounting.export",
      "customer_financial.accounting.reconcile",
      "customer_financial.record.delete",
      "customer_financial.record.recover"
    ],
    "adminDefaultCapabilities": [
      "customer_financial.source.review",
      "customer_financial.estimate.edit_draft",
      "customer_financial.estimate.edit_options",
      "customer_financial.estimate.request_signature",
      "customer_financial.estimate.review_signature",
      "customer_financial.estimate.request_work_handoff",
      "customer_financial.billing_identity.review",
      "customer_financial.billable_work.review",
      "customer_financial.invoice.edit_draft",
      "customer_financial.invoice.approve",
      "customer_financial.invoice.issue",
      "customer_financial.invoice.send",
      "customer_financial.invoice.correct",
      "customer_financial.invoice.void",
      "customer_financial.payment.initiate",
      "customer_financial.payment.record_offline",
      "customer_financial.payment.reconcile",
      "customer_financial.refund.issue",
      "customer_financial.write_off.record",
      "customer_financial.collection.action",
      "customer_financial.accounting.export",
      "customer_financial.accounting.reconcile"
    ],
    "memberDefaultCapabilities": [],
    "memberGrantableCapabilities": [
      "customer_financial.source.review",
      "customer_financial.estimate.edit_draft",
      "customer_financial.estimate.edit_options"
    ],
    "ownerOnlyCapabilities": [
      "customer_financial.document_numbering.review",
      "customer_financial.provider.connect",
      "customer_financial.record.delete",
      "customer_financial.record.recover"
    ],
    "customerSessionCapabilities": [
      "customer_financial.estimate.review_signature",
      "customer_financial.payment.initiate"
    ],
    "recentAuthSeconds": 600,
    "mfaFreshnessSeconds": 600,
    "independentApprovalSeconds": 600
  },
  "actionControl": {
    "customer_financial.source.review": {
      "mode": "single_control",
      "requires": ["exact_current_source_digest", "current_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.estimate.edit_draft": {
      "mode": "single_control",
      "requires": ["exact_current_draft_revision", "current_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.estimate.edit_options": {
      "mode": "single_control",
      "requires": ["exact_current_option_revision", "current_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.estimate.request_signature": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["proposal_total_minor_units_lte_1000000", "one_reviewed_recipient", "exact_current_mission24_proposal_digest"],
      "dualControlRequiredWhen": ["proposal_total_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_authority_identity_recipient_or_currentness_condition_missing"]
    },
    "customer_financial.estimate.review_signature": {
      "mode": "single_control",
      "requires": ["exact_current_signature_receipt", "current_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.estimate.request_work_handoff": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["accepted_option_total_minor_units_lte_1000000", "exact_current_mission24_acceptance", "current_receiving_adapter"],
      "dualControlRequiredWhen": ["accepted_option_total_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_authority_identity_adapter_or_currentness_condition_missing"]
    },
    "customer_financial.billing_identity.review": {
      "mode": "single_control",
      "requires": ["exact_current_customer_billing_identity", "current_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.document_numbering.review": {
      "mode": "single_control",
      "assurance": "current_session",
      "requires": ["exact_frozen_tenant_global_numbering_contract", "current_owner_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.billable_work.review": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["billable_amount_minor_units_lte_1000000", "exact_current_supported_billable_source", "current_source_authority"],
      "dualControlRequiredWhen": ["billable_amount_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_source_authority_identity_or_currentness_condition_missing"]
    },
    "customer_financial.invoice.edit_draft": {
      "mode": "single_control",
      "requires": ["exact_current_invoice_draft_revision", "current_capability", "fresh_confirmation", "reason"]
    },
    "customer_financial.invoice.approve": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["invoice_total_minor_units_lte_1000000", "exact_current_final_draft_digest", "current_billable_source"],
      "dualControlRequiredWhen": ["invoice_total_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_source_authority_identity_or_currentness_condition_missing"],
      "dualControlSeparation": "preparer_and_requester_cannot_approve"
    },
    "customer_financial.invoice.issue": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["invoice_total_minor_units_lte_1000000", "exact_current_approved_invoice_digest", "current_billable_source"],
      "dualControlRequiredWhen": ["invoice_total_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_source_authority_identity_or_currentness_condition_missing"],
      "dualControlSeparation": "preparer_and_requester_cannot_approve_or_execute"
    },
    "customer_financial.invoice.send": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["invoice_total_minor_units_lte_1000000", "exact_current_issued_document", "one_reviewed_recipient", "current_delivery_authority"],
      "dualControlRequiredWhen": ["invoice_total_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_document_recipient_delivery_or_currentness_condition_missing"]
    },
    "customer_financial.invoice.correct": {
      "mode": "conditional_dual_control",
      "maximumAbsoluteDeltaMinorUnits": "2500000",
      "singleControlAllowedWhen": ["absolute_delta_minor_units_lte_100000", "exact_current_issued_document", "current_mission24_authority_for_commercial_change"],
      "dualControlRequiredWhen": ["absolute_delta_minor_units_gt_100000_and_lte_2500000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_document_commercial_authority_identity_or_currentness_condition_missing"]
    },
    "customer_financial.invoice.void": {
      "mode": "dual_control",
      "singleControlAllowed": false,
      "requires": ["exact_current_issued_invoice_and_remaining_balance", "accepted_void_lifecycle", "two_different_current_humans", "reason"]
    },
    "customer_financial.provider.connect": {
      "mode": "conditional_dual_control",
      "testMode": {
        "singleControlAllowed": true,
        "operations": ["connect", "disconnect", "rotate", "revoke"],
        "requires": ["owner_capability", "recent_mfa", "exact_tenant_account_mode_and_capability_set", "fresh_confirmation", "reason"]
      },
      "liveMode": {
        "singleControlAllowed": false,
        "operations": ["connect", "enable", "disconnect", "rotate", "revoke"],
        "requires": ["two_different_current_humans", "separate_live_authorization", "accepted_live_canary_plan", "reason"]
      },
      "dualControlRequiredWhen": ["provider_mode_live"],
      "denyWhen": ["provider_mode_or_operation_missing", "operation_outside_mode_specific_set", "any_required_account_capability_assurance_authorization_or_currentness_condition_missing"]
    },
    "customer_financial.payment.initiate": {
      "mode": "customer_scoped_only",
      "customerPath": {
        "supported": true,
        "requires": ["one_exact_current_issued_invoice", "current_scoped_customer_session", "immutable_exact_allocation", "hosted_checkout"]
      },
      "staffPath": {
        "supported": false,
        "state": "staff_payment_initiation_unsupported"
      }
    },
    "customer_financial.payment.record_offline": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "1000000",
      "singleControlAllowedWhen": ["receipt_amount_minor_units_lte_100000", "supported_cash_or_check_method", "exact_current_invoice_allocation", "current_evidence_authority"],
      "dualControlRequiredWhen": ["receipt_amount_minor_units_gt_100000_and_lte_1000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_method_evidence_allocation_authority_identity_or_currentness_condition_missing"]
    },
    "customer_financial.payment.reconcile": {
      "mode": "dual_control",
      "singleControlAllowed": false,
      "appliesTo": ["manual_match", "manual_mismatch_resolution", "manual_settlement_override", "manual_allocation_override"],
      "authenticatedProviderProjectionIsHumanAction": false
    },
    "customer_financial.refund.issue": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "singleControlAllowedWhen": ["refund_minor_units_lte_100000", "exact_current_settled_original_charge", "refund_lte_current_refundable_remainder"],
      "dualControlRequiredWhen": ["refund_minor_units_gt_100000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_charge_remainder_authority_identity_or_currentness_condition_missing"],
      "dualControlSeparation": "requester_cannot_approve"
    },
    "customer_financial.write_off.record": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "1000000",
      "singleControlAllowedWhen": ["write_off_minor_units_lte_50000", "exact_current_balance_component", "no_tax_or_revenue_recognition_effect"],
      "dualControlRequiredWhen": ["write_off_minor_units_gt_50000_and_lte_1000000"],
      "denyWhen": ["amount_or_bound_missing", "any_required_balance_authority_identity_or_currentness_condition_missing"]
    },
    "customer_financial.collection.action": {
      "mode": "conditional_dual_control",
      "maximumMinorUnits": "10000000",
      "internalReviewPath": {
        "supported": true,
        "singleControlAllowedWhen": ["collectible_balance_minor_units_lte_1000000", "current_due_dispute_and_pending_tender_axes", "no_fee_charge_or_external_execution"]
      },
      "mission28HandoffPath": {
        "supported": true,
        "currentReceivingAdapterAvailable": false,
        "singleControlAllowedWhen": ["collectible_balance_minor_units_lte_1000000", "exact_current_invoice_version_and_recipient", "current_due_dispute_and_pending_tender_axes", "message_preview", "idempotency_and_cooldown", "current_receiving_adapter"]
      },
      "dualControlRequiredWhen": ["collectible_balance_minor_units_gt_1000000_and_lte_10000000"],
      "denyWhen": ["amount_or_bound_missing", "selected_path_missing", "any_required_selected_path_balance_due_dispute_pending_tender_recipient_adapter_or_currentness_condition_missing"],
      "externalExecutionAuthority": "mission28_only"
    },
    "customer_financial.accounting.export": {
      "mode": "conditional_dual_control",
      "maximumRecords": 1000,
      "maximumMinorUnits": "100000000",
      "singleControlAllowedWhen": ["record_count_lte_100", "absolute_total_minor_units_lte_10000000", "exact_current_minimized_fact_set", "current_receiving_adapter"],
      "dualControlRequiredWhen": ["record_count_gt_100_and_lte_1000", "absolute_total_minor_units_gt_10000000_and_lte_100000000"],
      "denyWhen": ["record_count_amount_or_bound_missing", "any_required_fact_set_adapter_identity_or_currentness_condition_missing"]
    },
    "customer_financial.accounting.reconcile": {
      "mode": "dual_control",
      "singleControlAllowed": false,
      "appliesTo": ["manual_match", "manual_mismatch_resolution", "manual_books_status_override"],
      "adapterAcknowledgementIsHumanAction": false
    },
    "customer_financial.record.delete": {
      "mode": "dual_control",
      "singleControlAllowed": false,
      "requires": ["two_different_current_humans", "exact_deletion_scope_and_digest", "current_retention_and_hold_state", "reason"]
    },
    "customer_financial.record.recover": {
      "mode": "conditional_dual_control",
      "singleControlAllowedWhen": ["read_only_receipt_lookup", "no_external_effect", "no_financial_effect", "exact_original_request_and_receipt"],
      "dualControlRequiredWhen": ["may_create_or_restore_external_effect", "may_create_or_restore_financial_effect"],
      "denyWhen": ["effect_classification_missing", "exact_original_request_or_receipt_missing", "any_required_authority_identity_or_currentness_condition_missing"],
      "effectMayExceedOriginalRequest": false
    }
  },
  "mobile": {
