{
  "name": "northstar-solutions",
  "version": "1.0.0",
  "description": "AI-powered virtual receptionist for home-service contractors",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --config jest.config.js",
    "build:retell-web": "esbuild src/browser/retellWebEntry.mjs --bundle --format=esm --platform=browser --minify --drop:console --legal-comments=external --outfile=public/js/vendor/retell-web-client.mjs",
    "test:integration": "jest --config jest.config.js tests/integration/",
    "test:api": "jest --config jest.config.js tests/api/",
    "test:regression": "jest --config jest.config.js tests/regression/",
    "inspect:production-migrations": "node scripts/inspect-production-migration-history.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "jsonwebtoken": "^9.0.3",
    "localtunnel": "^2.0.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "openai": "7.8.0",
    "pg": "^8.22.0",
    "retell-client-js-sdk": "2.0.8",
    "twilio": "^4.19.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
