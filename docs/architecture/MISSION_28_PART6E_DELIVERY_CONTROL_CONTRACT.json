  "phaseTreatment": {
    "queued": "cancel_expire_pause_revoke_supersede_drain_or_bulk_stop_may_block_future_claim; no effect is claimed",
    "leased": "cancel_denied; reducing scope records no-new-claim and no-renewal intent but cannot claim the existing lease or any in-flight work stopped",
    "in_flight": "accepted durable evidence is unavailable; cancellation retry and completion claims fail closed; only scope reduction may block later new attempts",
    "uncertain": "cancel and resend denied; exact Part6D reconciliation remains allowed; dead-letter preserves unresolved evidence and never claims no effect",
    "completed": "immutable effect evidence is never cancelled revoked rewritten or converted into no-effect evidence; accepted durable completion evidence is unavailable in this slice",
    "permanent_stop_no_effect": "may be dead-lettered; owner-reviewed retry records review only and requires a separately created new action identity",
    "permanent_stop_effect_or_unknown": "may be dead-lettered as effect-observed-or-unresolved; retry is permanently denied"
  },
  "transitionContract": {
    "pauseScope": "blocks later schedule lease and retry-classification creation while preserving reconciliation evidence",
    "revokePolicy": "terminal for the exact policy version and never resumes",
    "supersedePolicy": "requires an exact distinct active successor and terminally blocks the old policy version",
    "drainScope": "drained only when leased uncertain in-flight and completed-unresolved counts are zero; otherwise remains draining",
    "resumeScope": "only an exact paused or drained policy version with current active unexpired policy and exact-current latest sources may resume",
    "cancelAction": "only exact queued unclaimed action with no uncertainty or completed evidence",
    "expireAction": "requires schedule or policy expiry at the trusted clock and never claims leased uncertain or effect evidence was undone",
    "deadLetterAction": "requires exact Part6D permanent stop or uncertainty plus owner review; it never creates outcome proof",
    "ownerReviewedRetry": "requires dead-lettered exact definite-no-effect attempt-ceiling evidence and an active current policy/source set; the stopped action remains blocked and a later retry must be a new run/action/receipt identity",
    "bulkStop": "terminally blocks later schedules claims and retry classifications for the exact tenant or policy scope without rewriting existing action/effect evidence"
  },
